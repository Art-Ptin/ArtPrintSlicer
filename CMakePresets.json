{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC + Ninja (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc"
    }
  ],
  "testPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "output": { "outputOnFailure": true }
    }
  ]
}
